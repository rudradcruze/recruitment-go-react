# Copy this file to .env, then set the empty values. Do not commit .env.
# Write each value as plain text, with no quotes, no spaces, and no # or $ characters.
# Then the shell and Docker Compose read the file in the same way.
# Docker Compose uses a variable of your shell in place of the value in this file.
# Do not export POSTGRES_PASSWORD or the other variables of this file in your shell.
# The ports come from the port table in .claude/rules/architecture.md.

LOG_LEVEL=info

# The folder of the migration files. The path starts in the backend folder.
MIGRATIONS_DIR=migrations

# Ports on the host
API_PORT=5653
WEB_PORT=5651
ASYNQMON_PORT=5650

# Postgres. The host and the port are for make dev. Docker Compose sets its own for its containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5654
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
# Use "disable" on a private network. On a public network, use "require", "verify-ca" or "verify-full".
POSTGRES_SSLMODE=disable

# Redis. The host and the port are for make dev. Docker Compose sets its own for its containers.
# An empty REDIS_PASSWORD means no password.
REDIS_HOST=localhost
REDIS_PORT=5652
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# The first Admin. The migrate command makes it after the migrations, when no Admin has this email address.
# The password has 12 to 72 bytes. The command does not change the password of an Admin that exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# The demo Admin on the login page. Vite puts these values in the files of the page, so they are public.
# Use the same values as ADMIN_EMAIL and ADMIN_PASSWORD only for a demo. Leave them empty in deployment.
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=

# Worker
WORKER_CONCURRENCY=10

# API docs (Scalar at /docs)
API_DOCS_ENABLED=false
API_DOCS_AUTH_ENABLED=true
API_DOCS_USERNAME=
API_DOCS_PASSWORD=
